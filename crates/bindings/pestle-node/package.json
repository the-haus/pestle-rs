{
  "name": "@pestle-rs/node",
  "version": "0.3.0",
  "description": "Fast streaming HTML extraction for scrapers and AI agents in Node.js: CSS selectors, page metadata, links, embedded JSON, JSON-LD, microdata, RDFa and microformats, accessibility snapshots, robots.txt and sitemaps, in one pass and any charset (Rust, N-API).",
  "license": "MIT OR Apache-2.0",
  "packageManager": "yarn@4.5.1",
  "homepage": "https://github.com/the-haus/pestle-rs/tree/main/crates/bindings/pestle-node#readme",
  "bugs": {
    "url": "https://github.com/the-haus/pestle-rs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-haus/pestle-rs.git",
    "directory": "crates/bindings/pestle-node"
  },
  "keywords": [
    "html",
    "scraping",
    "scraper",
    "crawler",
    "extract",
    "css-selectors",
    "streaming",
    "structured-data",
    "json-ld",
    "microdata",
    "rdfa",
    "microformats",
    "schema.org",
    "opengraph",
    "accessibility",
    "aria-snapshot",
    "ai-agent",
    "llm",
    "robots.txt",
    "sitemap",
    "charset",
    "pest",
    "napi",
    "rust"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "ts/*.ts",
    "examples/",
    "pestle-node.*.node",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "napi": {
    "name": "pestle-node",
    "package": {
      "name": "@pestle-rs/node"
    },
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-musl",
        "x86_64-apple-darwin",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc",
        "aarch64-pc-windows-msvc"
      ]
    }
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:native": "napi build --platform --release --js false --dts native.generated.d.ts",
    "build:native:debug": "napi build --platform --js false --dts native.generated.d.ts",
    "build:native:grammar": "napi build --platform --release --features grammar --js false --dts native.generated.d.ts",
    "build:grammar": "yarn run build:native:grammar && yarn run build:ts",
    "build:ts": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node scripts/copy-native.mjs",
    "build": "yarn run build:native && yarn run build:ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.examples.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node --expose-gc --import tsx bench/bench.mts",
    "shootout": "node --import tsx bench/shootout.mts",
    "artifacts": "napi artifacts",
    "create-npm-dirs": "napi create-npm-dir -t .",
    "copy-license": "node -e \"const fs=require('fs');for(const f of ['LICENSE-MIT','LICENSE-APACHE','CHANGELOG.md'])fs.copyFileSync('../../../'+f,f)\"",
    "prepack": "yarn run copy-license && yarn run build",
    "pack:dry": "npm pack --dry-run",
    "smoke:install": "bash scripts/smoke-install.sh"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/n3": "^1",
    "@types/node": "^22.7.4",
    "cheerio": "^1",
    "chevrotain": "^11",
    "css-select": "^7.0.0",
    "htmlparser2": "^12.0.0",
    "jsonld": "^9.0.0",
    "linkedom": "^0.18",
    "microdata-rdf-streaming-parser": "^3.0.0",
    "microformats-parser": "^2.0.6",
    "n3": "^1",
    "node-html-parser": "^7",
    "parse5": "^7",
    "peggy": "^4",
    "rdfa-streaming-parser": "^3.0.2",
    "tsx": "^4",
    "typescript": "^5.6.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.1"
  }
}
